---
layout: default
---

<div class="people-grid my-4">
  {% unless page.show_page_title == false %}
    <h1 class="mb-4">{{ page.title | default: "People" }}</h1>
  {% endunless %}

  {% assign people_sections = "pi|Principal Investigator,phd|PhD Students,ms_undergraduate|MS/Undergraduate Students,visiting|Visiting Scholar/Students,alumni|Alumni" | split: "," %}
  {% for section in people_sections %}
    {% assign section_parts = section | split: "|" %}
    {% assign section_key = section_parts[0] %}
    {% assign section_title = section_parts[1] %}
    {% if section_key == 'ms_undergraduate' %}
      {% assign masters = page.profiles | where: "section", "masters" %}
      {% assign undergraduates = page.profiles | where: "section", "undergraduate" %}
      {% assign combined_students = page.profiles | where: "section", "ms_undergraduate" %}
      {% assign members = masters | concat: undergraduates | concat: combined_students %}
    {% else %}
      {% assign members = page.profiles | where: "section", section_key %}
    {% endif %}

    {% if members.size > 0 %}
      <section class="people-section mb-5">
        <h2 class="h4 mb-3">{{ section_title }}</h2>

        <div class="row">
          {% for p in members %}
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
              <div class="card person-card text-center">
                {% assign website = p.links | where: "icon", "fas fa-globe" | first %}
                {% assign scholar = p.links | where: "icon", "ai ai-google-scholar" | first %}
                {% if website %}
                  <a class="person-card-primary" href="{{ website.url }}" target="_blank" rel="noopener" aria-label="Visit {{ p.name | escape }}'s website"></a>
                {% elsif scholar %}
                  <a class="person-card-primary" href="{{ scholar.url }}" target="_blank" rel="noopener" aria-label="View {{ p.name | escape }}'s Google Scholar profile"></a>
                {% elsif p.email %}
                  <a class="person-card-primary" href="mailto:{{ p.email | escape }}" aria-label="Email {{ p.name | escape }}"></a>
                {% endif %}
                <div class="person-photo-frame">
                  <img
                    class="card-img-top person-photo"
                    src="{{ '/assets/img/' | append: p.image | relative_url }}"
                    alt="{{ p.name | escape }}"
                  >
                </div>
                <div class="card-body">
                  <h3 class="person-name{% if p.name.size > 18 %} person-name--compact{% endif %} mb-0">{{ p.name }}</h3>
                  <div class="person-links d-flex justify-content-center mt-2">
                    {% if p.email %}
                      <a class="mx-2" href="mailto:{{ p.email | escape }}" aria-label="Email {{ p.name | escape }}" title="Email">
                        <i class="fa-solid fa-envelope"></i>
                      </a>
                    {% endif %}
                    {% for l in p.links %}
                      <a class="mx-2" href="{{ l.url }}" target="_blank" rel="noopener">
                        <i class="{{ l.icon }}"></i>
                      </a>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% endfor %}
</div>
